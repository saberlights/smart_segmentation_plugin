{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "智能分段插件 (Smart Segmentation Plugin)",
  "description": "使用 LLM 智能切分回复文本，在语义自然的地方切分，保持原文内容不变，让回复更加灵活自然。",
  "author": {
    "name": "久远",
    "url": "https://github.com/saberlights"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/saberlights/smart_segmentation_plugin",
    "homepage": "https://github.com/saberlights/smart_segmentation_plugin",
    "documentation": "https://github.com/saberlights/smart_segmentation_plugin",
    "issues": "https://github.com/saberlights/smart_segmentation_plugin/issues"
  },
  "host_application": {
    "min_version": "0.11.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get_all",
    "send.text",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "saberlights.smart-segmentation-plugin"
}
